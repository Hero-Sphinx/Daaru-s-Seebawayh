# PostgreSQL (Neon/Supabase/Railway/local all work). After setting this, run:
#   npx prisma db execute --file db/schema.sql
#   npx prisma db pull && npx prisma generate
#   npx prisma db seed
# On a hosted provider (Neon/Supabase/Railway), use their connection string
# as given, but prefer `sslmode=verify-full` over `sslmode=require` if you
# get to pick — `require` triggers a real (non-fatal) node-postgres warning
# about its semantics changing in a future major version; `verify-full` is
# the explicit, future-proof form and works fine against their real CA-signed
# certs. Local Postgres normally needs no `sslmode` param at all.
DATABASE_URL=postgresql://user:password@localhost:5432/al_lisan

# The app's public address, used in password-reset links. Optional locally
# (the request's own host is used); set it in production, e.g.
# https://daaru-s-seebawayh.example.com
APP_URL=

# Password-reset emails. Free option, no domain needed — a Gmail account:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Put the account address in SMTP_USER and the 16-letter app password
#      (no spaces) in SMTP_PASS.
# Any other SMTP provider works too (set SMTP_HOST / SMTP_PORT).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
# Or Resend (needs your own domain): RESEND_API_KEY + EMAIL_FROM.
RESEND_API_KEY=
# Optional sender, e.g. "Daaru-s-Seebawayh <you@gmail.com>" (defaults to SMTP_USER).
EMAIL_FROM=
# Without any of these: in development the reset link is printed to the
# `npm run dev` console; in production "Forgot password?" is hidden and
# users are told to ask you (reset it with `npm run user:set-password`).

# CAMeL Tools morphology service (services/camel/) — root/lemma/POS enrichment
# (FR-4.2). Self-hosted, no API key needed; see services/camel/README.md to
# run it. Not started automatically by `npm run dev`.
CAMEL_SERVICE_URL=http://localhost:8001

# Gemini API — chapter summaries / Fawa'id extraction only (see README.md's
# AI usage policy: never used for grammar/morphology claims). Get a key at
# https://aistudio.google.com/apikey. Without it, POST /api/library/[id]/summarize
# returns a clear 503 — nothing else in the app depends on it.
GEMINI_API_KEY=
# Override if the default model name 404s (Gemini model IDs change over
# time) — see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
