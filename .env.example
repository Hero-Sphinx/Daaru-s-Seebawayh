# PostgreSQL — run `psql $DATABASE_URL -f db/schema.sql` to bootstrap
DATABASE_URL=postgres://postgres:postgres@localhost:5432/al_lisan

# QCRI Farasa API (POS tagging, segmentation, diacritization for non-Quranic text)
FARASA_API_KEY=

# Object storage for uploaded PDFs/EPUBs (S3-compatible)
LIBRARY_STORAGE_BUCKET=
LIBRARY_STORAGE_ACCESS_KEY=
LIBRARY_STORAGE_SECRET_KEY=
